{
  "mutate": ["components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "scripts/{pins,usage}.ts"],
  "plugins": ["@stryker-mutator/vitest-runner", "./stryker-browser-callbacks.js"],
  "ignorers": ["puppeteer-callbacks"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": ".stryker-reports/incremental.json",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": ".stryker-reports/mutation.json"
  },
  "ignorePatterns": [
    ".*",
    "/test/pages/**",
    "/test/render-pdf.test.ts",
    "/test/render-pptx.test.ts"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": 4
}

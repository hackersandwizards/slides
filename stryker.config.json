{
  "mutate": [
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "scripts/{pins,pptx-fonts,pptx-text,render-pdf,render-pptx,usage}.ts"
  ],
  "plugins": ["@stryker-mutator/vitest-runner", "./stryker-browser-callbacks.js"],
  "ignorers": ["puppeteer-callbacks"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": ".stryker-reports/mutation.json"
  },
  "ignorePatterns": [".*", "/test/pages/**"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": 4
}

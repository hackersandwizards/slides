{
  "name": "@hackersandwizards/slides",
  "version": "0.6.0",
  "private": true,
  "description": "The hackers&wizards slide engine: slide components, deck types, the slide stylesheet and the PDF renderer, shared by talks, trainer-hub and hycle-private.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "slides-density": "scripts/density.ts"
  },
  "files": [
    "components",
    "lib",
    "types",
    "styles",
    "scripts/render-pdf.ts",
    "scripts/density.ts",
    "specimen"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun run test && bun scripts/specimen.ts --check && brand-colours",
    "lint": "eslint --cache --concurrency=auto .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint --cache --concurrency=auto . --fix && prettier --write .",
    "check:staged": "bun .claude/skills/engineering/check-staged.ts",
    "specimen": "bun scripts/specimen.ts"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v0.10.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}

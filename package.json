{
  "name": "@hackersandwizards/slides",
  "version": "1.2.0",
  "private": true,
  "description": "The hackers&wizards slide engine: slide components, deck types, the slide stylesheet and the PDF renderer, shared by talks, trainer-hub and hycle-private.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "bin": {
    "slides-density": "scripts/density.ts",
    "slides-pins": "scripts/pins.ts",
    "slides-pptx": "scripts/render-pptx.ts"
  },
  "exports": {
    "./components/*": "./components/*.tsx",
    "./lib/deck-edit": "./lib/deck-edit.ts",
    "./lib/deck-edit-server": "./lib/deck-edit-server.ts",
    "./lib/deck-edit-mode": "./lib/deck-edit-mode.tsx",
    "./lib/logo": "./lib/logo.ts",
    "./lib/markdown": "./lib/markdown.tsx",
    "./lib/navigate": "./lib/navigate.ts",
    "./lib/next-adapter": "./lib/next-adapter.tsx",
    "./lib/print-context": "./lib/print-context.tsx",
    "./lib/slide-components": "./lib/slide-components.ts",
    "./lib/slide-utils": "./lib/slide-utils.ts",
    "./lib/stage-utils": "./lib/stage-utils.ts",
    "./lib/use-progressive-reveal": "./lib/use-progressive-reveal.ts",
    "./types/slide": "./types/slide.ts",
    "./styles/slides.css": "./styles/slides.css",
    "./styles/sources.css": "./styles/sources.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./scripts/render-pdf": "./scripts/render-pdf.ts",
    "./specimen/slide-catalogue": "./specimen/slide-catalogue.ts",
    "./specimen/slide-catalogue/*": "./specimen/slide-catalogue/*"
  },
  "files": [
    "components",
    "lib",
    "types",
    "styles",
    "scripts/render-pdf.ts",
    "scripts/density.ts",
    "scripts/pins.ts",
    "scripts/render-pptx.ts",
    "specimen"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "scaffolding check",
    "test": "bun --bun vitest run --exclude 'test/pages/**'",
    "check:pages": "bun --bun vitest run test/pages",
    "check:pins": "bun scripts/pins.ts",
    "check:colours": "brand-colours",
    "check:copies": "brand-copies",
    "check:elements": "brand-elements",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "check:staged": "check-staged",
    "dev": "ASTRO_DEV_BACKGROUND=1 bun --bun astro dev --root catalog",
    "catalog": "bun run dev --open /",
    "build": "astro build --root catalog"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "jszip": "^3.10.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "pptxgenjs": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.3",
    "image-size": "2.0.4"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.2",
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.0.0",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.0.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v2.2.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "7.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "jszip": "3.10.1",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "pptxgenjs": "4.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "admin": {
    "name": "slides",
    "designSystem": "https://hackersandwizards.github.io/slides/",
    "products": [
      {
        "label": "Slide types",
        "href": "https://hackersandwizards.github.io/slides/"
      }
    ]
  },
  "scaffolding": {
    "styles": [
      "./styles/slides.css",
      "./styles/sources.css"
    ],
    "allow": [
      {
        "check": "coupling",
        "path": "catalog/print.ts",
        "reason": "the URL the print pages in dist/catalog/print/ link brand's files by, relative to the page, not a path in the checkout"
      }
    ],
    "test": "test",
    "uniqueNames": [
      "GET"
    ],
    "check": [
      [
        "check:pins",
        "check:colours",
        "check:copies"
      ],
      "check:pages",
      "check:elements"
    ]
  }
}

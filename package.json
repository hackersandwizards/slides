{
  "name": "@hackersandwizards/slides",
  "version": "2.1.0",
  "private": true,
  "description": "The hackers&wizards slide engine: slide components, deck types, the slide stylesheet and the PDF renderer, shared by talks, trainer-hub and hycle-private.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "bin": {
    "slides-density": "scripts/density.ts",
    "slides-pins": "scripts/pins.ts",
    "slides-pptx": "scripts/render-pptx.ts"
  },
  "exports": {
    "./components/*": "./components/*.tsx",
    "./lib/deck-edit": "./lib/deck-edit.ts",
    "./lib/deck-edit-server": "./lib/deck-edit-server.ts",
    "./lib/deck-edit-mode": "./lib/deck-edit-mode.tsx",
    "./lib/logo": "./lib/logo.ts",
    "./lib/markdown": "./lib/markdown.tsx",
    "./lib/navigate": "./lib/navigate.ts",
    "./lib/next-adapter": "./lib/next-adapter.tsx",
    "./lib/print-context": "./lib/print-context.tsx",
    "./lib/slide-components": "./lib/slide-components.ts",
    "./lib/slide-utils": "./lib/slide-utils.ts",
    "./lib/stage-utils": "./lib/stage-utils.ts",
    "./lib/use-progressive-reveal": "./lib/use-progressive-reveal.ts",
    "./lib/vite": "./lib/vite.ts",
    "./types/slide": "./types/slide.ts",
    "./styles/slides.css": "./styles/slides.css",
    "./styles/sources.css": "./styles/sources.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./scripts/render-pdf": "./scripts/render-pdf.ts",
    "./specimen/slide-catalog": "./specimen/slide-catalog.ts",
    "./specimen/slide-catalog/*": "./specimen/slide-catalog/*",
    "./catalog/SlideFrame.astro": "./catalog/SlideFrame.astro"
  },
  "files": [
    "components",
    "lib",
    "types",
    "styles",
    "scripts/render-pdf.ts",
    "scripts/density.ts",
    "scripts/pins.ts",
    "scripts/render-pptx.ts",
    "specimen",
    "catalog/SlideFrame.astro"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "scaffolding check",
    "test": "bun --bun vitest run --exclude 'test/pages/**'",
    "check:pages": "bun --bun vitest run test/pages",
    "check:pins": "bun scripts/pins.ts",
    "check:colours": "brand-colours",
    "check:copies": "brand-copies",
    "check:retired": "brand-retired dist",
    "check:elements": "brand-elements",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "check:staged": "check-staged",
    "dev": "ASTRO_DEV_BACKGROUND=1 bun --bun astro dev --root catalog",
    "catalog": "bun run dev --open /",
    "build": "check-lock astro build --root catalog",
    "preview": "ASTRO_PREVIEW_BACKGROUND=1 bun --bun astro preview --root catalog",
    "check:markers": "mkdir -p node_modules/.cache/slides-markers && ln -sfn \"$PWD/dist\" node_modules/.cache/slides-markers/slides && brand-markers --site node_modules/.cache/slides-markers --catalog dist --catalog-at /slides /slides/catalog/print/frames.html"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "astro": "^7.4.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@hackersandwizards/brand": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "pptxgenjs": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.5",
    "image-size": "2.1.0"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.4",
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.12.0",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.42.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v3.0.0",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "astro": "7.4.7",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "jszip": "3.10.2",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "pptxgenjs": "4.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shiki": "4.6.0",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "admin": {
    "name": "slides",
    "designSystem": "https://hackersandwizards.github.io/slides/catalog/",
    "products": [
      {
        "label": "Slide types",
        "href": "https://hackersandwizards.github.io/slides/catalog/"
      }
    ]
  },
  "scaffolding": {
    "styles": [
      "./styles/slides.css",
      "./styles/sources.css"
    ],
    "allow": [
      {
        "check": "coupling",
        "path": "catalog/brand-urls.ts",
        "text": "../../brand",
        "reason": "the URL the print pages in dist/catalog/print/ link brand's files by, relative to the page, not a path in the checkout"
      },
      {
        "check": "coupling",
        "path": "catalog/print.ts",
        "text": "../../_astro/",
        "reason": "the URL the print pages in dist/catalog/print/ name the bundler's files by, relative to the page, not a path in the checkout"
      },
      {
        "check": "coupling",
        "path": "catalog/brand-urls.ts",
        "text": "node_modules\\/@hackersandwizards",
        "reason": "the pattern placeBrandUrls matches in the url() Tailwind writes into the compiled stylesheet for an imported brand file, not a path the code reads"
      },
      {
        "check": "coupling",
        "path": "test/brand-urls.test.ts",
        "text": "node_modules/@hackersandwizards/brand/",
        "reason": "input for placeBrandUrls: the url() Tailwind writes into the compiled stylesheet for an imported brand file, which the test expects it to place or refuse, not a path the test reads"
      },
      {
        "check": "history",
        "path": "types/slide.ts",
        "text": "bis 15.11.",
        "reason": "a format example of an agenda item's `when` in a German deck, not a date of the code's history"
      }
    ],
    "test": "test",
    "uniqueNames": [
      "GET"
    ],
    "check": [
      [
        "check:pins",
        "check:colours",
        "check:copies",
        "check:retired"
      ],
      "check:pages",
      "check:elements",
      "check:markers"
    ]
  }
}

{
  "name": "@hackersandwizards/slides",
  "version": "0.3.1",
  "private": true,
  "description": "The hackers&wizards slide engine: slide components, deck types, the slide stylesheet and the PDF renderer, shared by talks, trainer-hub and hycle-private.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "components",
    "lib",
    "types",
    "styles",
    "scripts/render-pdf.ts"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$PWD\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun run test",
    "lint": "eslint --cache --concurrency=auto .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint --cache --concurrency=auto . --fix && prettier --write ."
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "lucide-react": "^0.556.0",
    "motion": "^13.2.0",
    "puppeteer": "^25.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/brand": "git+ssh://git@github.com/hackersandwizards/brand.git#v0.9.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "lucide-react": "0.556.0",
    "motion": "13.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}

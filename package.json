{
  "name": "@hackersandwizards/slides",
  "version": "0.11.2",
  "private": true,
  "description": "The hackers&wizards slide engine: slide components, deck types, the slide stylesheet and the PDF renderer, shared by talks, trainer-hub and hycle-private.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "slides-density": "scripts/density.ts",
    "slides-pptx": "scripts/render-pptx.ts"
  },
  "exports": {
    "./components/*": "./components/*.tsx",
    "./lib/deck-edit": "./lib/deck-edit.ts",
    "./lib/deck-edit-mode": "./lib/deck-edit-mode.tsx",
    "./lib/logo": "./lib/logo.ts",
    "./lib/markdown": "./lib/markdown.tsx",
    "./lib/navigate": "./lib/navigate.ts",
    "./lib/next-adapter": "./lib/next-adapter.tsx",
    "./lib/print-context": "./lib/print-context.tsx",
    "./lib/slide-components": "./lib/slide-components.ts",
    "./lib/slide-utils": "./lib/slide-utils.ts",
    "./lib/stage-utils": "./lib/stage-utils.ts",
    "./lib/use-progressive-reveal": "./lib/use-progressive-reveal.ts",
    "./types/slide": "./types/slide.ts",
    "./styles/slides.css": "./styles/slides.css",
    "./styles/sources.css": "./styles/sources.css",
    "./scripts/render-pdf": "./scripts/render-pdf.ts",
    "./specimen/slide-catalogue": "./specimen/slide-catalogue.ts",
    "./specimen/slide-catalogue/*": "./specimen/slide-catalogue/*"
  },
  "files": [
    "components",
    "lib",
    "types",
    "styles",
    "scripts/render-pdf.ts",
    "scripts/density.ts",
    "scripts/render-pptx.ts",
    "specimen"
  ],
  "scripts": {
    "preinstall": "node .claude/skills/engineering/only-bun.cjs",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun run test && bun scripts/specimen.ts --check && brand-colours",
    "lint": "bun --bun eslint --cache --concurrency=auto .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "check:staged": "bun .claude/skills/engineering/check-staged.ts",
    "specimen": "bun scripts/specimen.ts"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.3",
    "image-size": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v0.21.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1"
  }
}

---
import { brandHref } from "../../../brand-urls";
import catalogs from "@hackersandwizards/brand/catalogs.json";
import { name } from "@hackersandwizards/brand/verbal.json";
import { logoSizes } from "../../../../lib/brand-logos";
import {
  entries,
  exceptionSections,
  JOBS,
  partRows,
  partTiles,
  replacedRows,
  usesTiles,
  type Job,
} from "../../../print";

// Each entry's slide count, where the dev server was started with SLIDES_USAGE (catalog/usage.ts);
// a "-2" anchor is a second tile of one entry, which slides-usage never counts.
const usage = __SLIDES_USAGE__;
const slideCount = (n: number) => `${n} ${n === 1 ? "slide" : "slides"}`;
const hasCount = (id: string) => !!usage && !/-\d+$/.test(id);
const tiles = entries.map(({ id, html }) =>
  hasCount(id)
    ? html.replace(
        "</figcaption>",
        ` <span class="hw-pill" ${usage!.entries[id] ? 'data-tone="neutral"' : 'data-variant="outline"'} data-usage>${slideCount(usage!.entries[id] ?? 0)}</span></figcaption>`,
      )
    : html,
);
const strays = Object.entries(usage?.entries ?? {}).filter(
  ([id]) => !entries.some((e) => e.id === id),
);

const jobLinks = (Object.keys(JOBS) as Job[])
  .map(
    (j) =>
      `<li><a href="#catalog" data-job="${j}">${JOBS[j]}<span class="hw-nav-count">${entries.filter((e) => e.jobs.includes(j)).length}</span></a></li>`,
  )
  .join("\n");
---

<!doctype html>
<html lang="en" class="hw-focus-ring">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Slide specimen, @hackersandwizards/slides</title>
    <meta
      name="description"
      content="Every slide type of the h&amp;w slide engine with each of its variants, its content blocks, parts and shared elements, as they look in a printed deck."
    />
    <!-- The faces the first screen sets, fetched with the stylesheets: found late through them, their
     swap moved the parts table (Lighthouse CLS 0.131 on desktop). -->
    {[
      "inter-latin-400-normal",
      "inter-latin-500-normal",
      "inter-latin-600-normal",
      "jetbrains-mono-latin-700-normal",
    ].map((face) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        crossorigin
        href={`${brandHref}/fonts/${face}.woff2`}
      />
    ))}
    <link rel="icon" href={`${brandHref}/logos/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${brandHref}/logos/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${brandHref}/tokens.root.css`} />
    <link rel="stylesheet" href={`${brandHref}/header.css`} />
    <link rel="stylesheet" href="build/slides.css" />
    {["focus", "field", "search", "nav", "table", "empty"].map((name) => (
      <link rel="stylesheet" href={`${brandHref}/elements/${name}.css`} />
    ))}
    <style is:inline>
      body {
        margin: 0;
        background: var(--color-tint);
        color: var(--color-ink);
        font-family: var(--font-sans);
      }
      .intro {
        margin: 1.5rem 0 2rem;
        max-width: 60rem;
      }
      h1 {
        font: 700 1.5rem/1.25 var(--font-mono);
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem;
      }
      h2 {
        font: 700 1.125rem/1.3 var(--font-mono);
        margin: 0 0 1rem;
      }
      .intro p {
        margin: 0 0 0.5rem;
        font-size: 1rem;
      }
      .intro .setup {
        font-size: 0.875rem;
        color: var(--color-muted);
      }
      .sheet {
        display: grid;
        grid-template-columns: repeat(auto-fill, 480px);
        gap: 2rem 1.5rem;
        padding-bottom: 4rem;
      }
      figure {
        margin: 0;
        scroll-margin-top: 5.5rem;
      }
      figcaption {
        font: 600 0.875rem/1.4 var(--font-mono);
        margin-bottom: 0.5rem;
      }
      figcaption a {
        color: inherit;
      }
      .frame {
        width: 480px;
        height: 270px;
        overflow: hidden;
        outline: 1px solid var(--color-border);
      }
      iframe {
        width: 1920px;
        height: 1080px;
        border: 0;
        transform: scale(0.25);
        transform-origin: 0 0;
      }
      figure:target {
        grid-column: 1 / -1;
      }
      figure:target .frame {
        width: 1440px;
        height: 810px;
      }
      figure:target iframe {
        transform: scale(0.75);
      }
      .layers {
        max-width: 60rem;
        font-size: 1rem;
        margin: 0 0 1rem;
      }
      table.parts {
        margin: 0 0 2rem;
        max-width: 80rem;
      }
      .elements {
        grid-template-columns: repeat(auto-fill, 640px);
      }
      .element figcaption {
        display: flex;
        gap: 0.75rem;
        align-items: baseline;
      }
      .element .from,
      .exception .setup {
        font-weight: 400;
        color: var(--color-muted);
      }
      .exception {
        max-width: 60rem;
        margin: 0 0 2rem;
      }
      .exception h3 {
        font: 600 1rem/1.4 var(--font-mono);
        margin: 0 0 var(--spacing-tight);
      }
      .exception p {
        margin: 0 0 0.5rem;
      }
      .catalog {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
      }
      .jobs {
        position: sticky;
        top: 5.5rem;
      }
      .find {
        max-width: 30rem;
        margin: 0 0 1.5rem;
      }
      .meta {
        display: none;
        font-size: 0.875rem;
        color: var(--color-muted);
        margin: 0.5rem 0 0;
      }
      figure:target .meta {
        display: block;
      }
      .when {
        margin: 0.5rem 0 var(--spacing-tight);
        font-size: 0.9375rem;
      }
      .dos {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.125rem 0.5rem;
        margin: 0;
        font-size: 0.875rem;
        color: var(--color-muted);
      }
      .dos dt {
        font-weight: 600;
      }
      .dos dd {
        margin: 0;
      }
      .usage {
        max-width: 60rem;
        margin: 0 0 1.5rem;
        --hw-card-pad: 0.75rem 1rem;
      }
      /* A count's pill is 27 px high: a caption without one, a "-2" tile's, keeps the frames in line. */
      .counted figcaption {
        min-height: 1.6875rem;
      }
      .note {
        max-width: 480px;
        font-size: 0.875rem;
        color: var(--color-muted);
        margin: 0;
      }
    </style>
  </head>
  <body>
    <header class="hw-header">
      <div class="hw-header-strip"></div>
      <div class="hw-header-row hw-container">
        <a class="hw-header-brand" href="#" aria-label={`${name.company} Slides`}>
          <img
            class="hw-header-logo"
            src={`${brandHref}/logos/lockup-screen.svg`}
            alt=""
            {...logoSizes["lockup-screen.svg"]}
          />
          <img
            class="hw-header-logo-night"
            src={`${brandHref}/logos/lockup-screen-night.svg`}
            alt=""
            {...logoSizes["lockup-screen-night.svg"]}
          />
          <span class="hw-header-product">Slides</span>
        </a>
        {/* Brand's catalogs; Slides links home relatively, as the page opens from the disk. */}
        <nav class="hw-header-nav" aria-label="Main" data-hw-catalogs>
          {catalogs.map(({ name, href }) => (
            <a
              class="hw-header-link"
              href={name === "Slides" ? "../../index.html" : href}
              aria-current={name === "Slides" ? "page" : undefined}
            >
              {name}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="hw-container">
      <div class="intro">
        <h1>Slide specimen</h1>
        <p>
          Every slide type of the h&amp;w slide engine with each of its variants, and the content
          blocks a content slide is built from, as they look in a printed deck. All content is made
          up. Click a name to see its slide at 1440 px.
        </p>
        <p class="setup">
          Built by <code>bun run build</code> from <code>specimen/slide-catalog.ts</code> into{" "}
          <code>dist/</code>, where it also opens from the disk: fonts and logos load from{" "}
          <code>dist/brand/</code>. <code>bun run dev</code> serves it at{" "}
          <code>http://127.0.0.1:4335/catalog/print/</code>, beside the{" "}
          <a href="../../index.html">catalog</a> of every slide type and part.
        </p>
      </div>
      <h2 id="parts">Parts</h2>
      <p class="layers">
        Three layers, as in the document engine. <strong>Tokens</strong>:{" "}
        <code>styles/tokens.css</code> names every value a slide draws (colour, type step, tracking,
        leading, measure, rule) from <code>@hackersandwizards/brand</code>;{" "}
        <code>test/tokens.test.ts</code> fails on a raw length or colour anywhere else.{" "}
        <strong>Parts</strong> below are built from tokens only, each with its variants.{" "}
        <strong>Slide types</strong> compose parts; a difference between two types is a part's
        variant.
      </p>
      <table class="parts hw-table">
        <thead>
          <tr>
            <th>Part</th>
            <th>What it is</th>
            <th>Used by</th>
          </tr>
        </thead>
        <tbody>
          <Fragment set:html={partRows} />
        </tbody>
      </table>
      <div class="sheet">
        <Fragment set:html={partTiles} />
      </div>
      <h2 id="elements">Shared elements</h2>
      <p class="layers">
        The elements the slides take from <code>@hackersandwizards/brand</code>, each at the stage
        scale (<code>data-hw-scale="stage"</code>, which every slide sets), on day and on night,
        then the elements the slides keep as their own, each with its reason.{" "}
        <code>brand-elements</code> measures both, last in <code>bun run check</code>, here and on{" "}
        <a href="frames.html">every specimen slide</a>.
      </p>
      <div class="sheet elements">
        <Fragment set:html={usesTiles} />
      </div>
      <Fragment set:html={exceptionSections} />
      <h2 id="catalog">Catalogue</h2>
      <p class="layers">
        Every slide type, variant and content block, by the job a slide does. An entry may sit under
        two jobs. The search finds every type, block and variant name, and the old names of types
        that now draw through another. Click a name to see its slide at 1440 px with its jobs.
      </p>
      {usage && (
        <p class="layers" data-usage>
          Each entry counts the slides using it in {usage.decks}{" "}
          {usage.decks === 1 ? "deck" : "decks"} of {slideCount(usage.slides)}, from{" "}
          {usage.files.map((file, i) => (
            <>
              {i > 0 && ", "}
              <code>{file}</code>
            </>
          ))}
          . A slide using two entries counts for both.
        </p>
      )}
      {strays.length > 0 && (
        <p class="usage hw-status" data-tone="warning" data-usage-stray>
          No entry here has these names from the counts:{" "}
          {strays.map(([id, n], i) => (
            <>
              {i > 0 && ", "}
              <code>{id}</code> ({slideCount(n)})
            </>
          ))}
          . These slides count for no entry above: run <code>slides-usage</code> again with this
          version of the engine.
        </p>
      )}
      <div class="catalog">
        <nav class="jobs hw-nav" aria-label="Communication jobs">
          <ul>
            <li>
              <a href="#catalog" data-job="" aria-current="true">
                All<span class="hw-nav-count">{entries.length}</span>
              </a>
            </li>
            <Fragment set:html={jobLinks} />
          </ul>
        </nav>
        <div>
          <div class="hw-search find">
            <input
              type="search"
              id="find"
              class="hw-field"
              placeholder="Search a type, block, variant or job"
              aria-label="Search the catalogue"
            />
          </div>
          <div class:list={["sheet tiles", { counted: usage }]}>
            <Fragment set:html={tiles.join("\n")} />
          </div>
          <p id="none" class="hw-empty" data-variant="plain" hidden>
            No entry matches.
          </p>
        </div>
      </div>
      <h2 id="replaced">Replaced forms</h2>
      <p class="layers">
        Forms another entry now draws. Decks still using them render unchanged until each moves
        (phase 4); a new slide takes the entry on the right. The search above finds each by its old
        name.
      </p>
      <table class="parts hw-table">
        <thead>
          <tr>
            <th>Old form</th>
            <th>Drawn as</th>
          </tr>
        </thead>
        <tbody>
          <Fragment set:html={replacedRows} />
        </tbody>
      </table>
    </main>
    <script is:inline>
      const tiles = [...document.querySelectorAll(".tiles figure")];
      const find = document.getElementById("find");
      let job = "";
      const apply = () => {
        const q = find.value.trim().toLowerCase();
        let shown = 0;
        for (const t of tiles) {
          const on =
            (!job || t.dataset.jobs.split(" ").includes(job)) &&
            (!q || t.dataset.search.includes(q));
          t.hidden = !on;
          shown += on;
        }
        document.getElementById("none").hidden = shown > 0;
      };
      const jobs = [...document.querySelectorAll(".jobs a")];
      for (const a of jobs)
        a.addEventListener("click", (event) => {
          event.preventDefault();
          job = a.dataset.job;
          for (const o of jobs) o.removeAttribute("aria-current");
          a.setAttribute("aria-current", "true");
          apply();
        });
      find.addEventListener("input", apply);
    </script>
  </body>
</html>

---
// A slide fills its window, so the dashboard frames its preview page at brand's slide page size,
// scaled to the card: at the card's own size a phone's window was too short for the slide.
// `?revealed` opens a slide with every build step shown.
interface Props {
  component: string;
  part?: boolean;
}
const { component, part } = Astro.props;
const path = Astro.url.pathname;
const preview = path.includes("/stories/");
const src = path.replace("/dashboard/", "/stories/");
---

{preview ? (
  <div class="slide-story" data-story-of={component} data-hw-scale="stage">
    {!part && <script is:inline>
      {
        const url = new URL(location.href);
        url.searchParams.set("revealed", "");
        history.replaceState(history.state, "", url);
      }
    </script>}
    <slot />
  </div>
) : (
  <div class="story-embed" data-story-of={component}>
    <div class="story-stage hw-card">
      <iframe src={src} title={`${component} story`} loading="lazy" />
    </div>
    <script is:inline>
      {
        const stage = document.currentScript.previousElementSibling;
        const frame = stage.firstElementChild;
        new ResizeObserver(() => {
          frame.style.transform = `scale(${stage.clientWidth / frame.offsetWidth})`;
        }).observe(stage);
      }
    </script>
    <a href={src} target="_blank" rel="noreferrer">
      Open full screen
    </a>
  </div>
)}

<style>
  /* A deck's page stays light behind a light slide when the catalogue is dark. */
  .slide-story {
    position: fixed;
    inset: 0;
    overflow: auto;
    background: var(--color-bg);
    color-scheme: light;
    /* A deck's html sets Tailwind's line height of 1.5, which Astrobook's unlayered html rule
       (1.15) beats; brand has no token for it yet. */
    line-height: 1.5;
  }
  .story-embed {
    padding: 1rem;
  }
  .story-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    --hw-card-pad: 0;
  }
  .story-stage iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--slide-page-width);
    height: var(--slide-page-height);
    border: 0;
    transform-origin: 0 0;
  }
  .story-embed a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--text-ui);
    color: inherit;
  }
</style>

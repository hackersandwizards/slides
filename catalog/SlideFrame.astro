---
import brand from "@hackersandwizards/brand/tokens.json";

// A slide fills its window, so the dashboard frames its preview page at brand's slide page size,
// scaled to the card: at the card's own size a phone's window was too short for the slide. The card
// takes the largest 16:9 box that fits both the page's width and the scroll pane's height under
// the story bar, so the whole slide shows without scrolling.
// `?revealed` opens a slide with every build step shown. A consumer whose catalog loads another
// stylesheet names the slides' own in `css`, a URL with the site's base such as a `?url` import,
// linked on the story page alone; `light` keeps that page light whatever the catalog's theme,
// marking it `data-deck` for a theme sync that skips a deck.
interface Props {
  component: string;
  part?: boolean;
  css?: string;
  light?: boolean;
}
const { component, part, css, light } = Astro.props;
const path = Astro.url.pathname;
const preview = path.includes("/stories/");
const src = path.replace("/dashboard/", "/stories/");
// The dashboard page's own stylesheet need carry no slide token: the frame imports the page size
// and its card below. The card's line is the catalog's own colour, its corner the site's.
const corner = `--hw-card-corner:${brand.tokens["--radius-brand"]}`;
---

{preview ? (
  <div class="slide-story" data-story-of={component} data-hw-scale="stage">
    {light && <script is:inline>
      {
        const root = document.documentElement;
        root.dataset.deck = "";
        root.classList.remove("dark");
        root.dataset.theme = "light";
        root.style.colorScheme = "light";
      }
    </script>}
    {css && <link rel="stylesheet" href={css} />}
    {!part && <script is:inline>
      {
        const url = new URL(location.href);
        url.searchParams.set("revealed", "");
        history.replaceState(history.state, "", url);
      }
    </script>}
    <slot />
  </div>
) : (
  <div class="story-embed" data-story-of={component} style={corner}>
    <div class="story-stage hw-card" popover>
      <iframe src={src} title={`${component} story`} loading="lazy" />
      <button class="story-close hw-button" type="button">
        Close
      </button>
    </div>
    <button class="story-enlarge hw-button" type="button">
      Enlarge slide
    </button>
    <script is:inline>
      {
        const embed = document.currentScript.parentElement;
        const stage = embed.querySelector(".story-stage");
        const frame = stage.firstElementChild;
        const pane = embed.parentElement;
        const fit = () => {
          // Enlarged, the slide fills the window, across a portrait phone so it is read turned.
          if (stage.matches(":popover-open")) {
            stage.style.width = "";
            const { clientWidth: w, clientHeight: h } = stage;
            const [slideW, slideH] = [frame.offsetWidth, frame.offsetHeight];
            const turned = h > w;
            stage.toggleAttribute("data-turned", turned);
            const scale = turned
              ? Math.min(h / slideW, w / slideH)
              : Math.min(w / slideW, h / slideH);
            frame.style.transform = turned
              ? `translate(${(w + slideH * scale) / 2}px, ${(h - slideW * scale) / 2}px) rotate(90deg) scale(${scale})`
              : `translate(${(w - slideW * scale) / 2}px, ${(h - slideH * scale) / 2}px) scale(${scale})`;
            return;
          }
          // The pane's height under the stage's top, less the padding below the stage.
          const box = stage.getBoundingClientRect();
          const top = box.top - pane.getBoundingClientRect().top;
          const below = embed.getBoundingClientRect().bottom - box.bottom;
          const height = pane.clientHeight - top - pane.scrollTop - below;
          // With no height left the card takes the page's width and the pane scrolls.
          stage.style.width = height > 0 ? `${(height * 16) / 9}px` : "";
          frame.style.transform = `scale(${stage.clientWidth / frame.offsetWidth})`;
        };
        new ResizeObserver(fit).observe(pane);
        stage.addEventListener("toggle", fit);
        embed.querySelector(".story-enlarge").onclick = () => stage.showPopover();
        embed.querySelector(".story-close").onclick = () => stage.hidePopover();
        // A face that loads late changes the story bar's height but not the pane's.
        document.fonts.ready.then(fit);
      }
    </script>
  </div>
)}

<style>
  @import "@hackersandwizards/brand/stage.css";
  @import "@hackersandwizards/brand/elements/card.css";
  @import "@hackersandwizards/brand/elements/button.css";

  /* A deck's page stays light behind a light slide when the catalog is dark. */
  .slide-story {
    position: fixed;
    inset: 0;
    overflow: auto;
    background: var(--color-bg);
    color-scheme: light;
    /* A deck's html sets Tailwind's line height of 1.5, which Astrobook's unlayered html rule
       (1.15) beats; brand has no token for it yet. */
    line-height: 1.5;
  }
  .story-embed {
    padding: 1rem;
  }
  .story-stage {
    position: relative;
    max-width: 100%;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    --hw-card-pad: 0;
    /* Open or not it stays in the page: a popover's own defaults would hide and size it. */
    display: block;
    width: auto;
    height: auto;
    background: Canvas;
  }
  .story-stage:popover-open {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    margin: 0;
    aspect-ratio: auto;
    --hw-card-corner: 0;
    --hw-hairline: 0;
  }
  .story-close {
    display: none;
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
  }
  .story-stage:popover-open .story-close {
    display: block;
  }
  .story-stage[data-turned] .story-close {
    writing-mode: vertical-rl;
  }
  .story-enlarge {
    display: none;
    margin: 0.75rem auto 0;
  }
  /* Below this width the card draws a slide's text under 12 px. */
  @media (max-width: 40rem) {
    .story-enlarge {
      display: block;
    }
  }
  .story-stage iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--slide-page-width);
    height: var(--slide-page-height);
    border: 0;
    transform-origin: 0 0;
  }
</style>

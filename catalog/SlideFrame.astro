---
// A slide fills its window, so the dashboard frames its preview page at brand's slide page size,
// scaled to the card: at the card's own size a phone's window was too short for the slide. The card
// takes the largest 16:9 box that fits both the page's width and the scroll pane's height under
// the story bar, so the whole slide shows without scrolling.
// `?revealed` opens a slide with every build step shown. A consumer whose catalog loads another
// stylesheet names the slides' own in `css`, a URL with the site's base such as a `?url` import,
// linked on the story page alone; `light` keeps that page light whatever the catalog's theme,
// marking it `data-deck` for a theme sync that skips a deck.
interface Props {
  component: string;
  part?: boolean;
  css?: string;
  light?: boolean;
}
const { component, part, css, light } = Astro.props;
const path = Astro.url.pathname;
const preview = path.includes("/stories/");
const src = path.replace("/dashboard/", "/stories/");
---

{preview ? (
  <div class="slide-story" data-story-of={component} data-hw-scale="stage">
    {light && <script is:inline>
      {
        const root = document.documentElement;
        root.dataset.deck = "";
        root.classList.remove("dark");
        root.dataset.theme = "light";
        root.style.colorScheme = "light";
      }
    </script>}
    {css && <link rel="stylesheet" href={css} />}
    {!part && <script is:inline>
      {
        const url = new URL(location.href);
        url.searchParams.set("revealed", "");
        history.replaceState(history.state, "", url);
      }
    </script>}
    <slot />
  </div>
) : (
  <div class="story-embed" data-story-of={component}>
    <div class="story-stage hw-card">
      <iframe src={src} title={`${component} story`} loading="lazy" />
    </div>
    <script is:inline>
      {
        const stage = document.currentScript.previousElementSibling;
        const frame = stage.firstElementChild;
        const embed = stage.parentElement;
        const pane = embed.parentElement;
        const fit = () => {
          // The pane's height under the stage's top, less the padding below the stage.
          const box = stage.getBoundingClientRect();
          const top = box.top - pane.getBoundingClientRect().top;
          const below = embed.getBoundingClientRect().bottom - box.bottom;
          const height = pane.clientHeight - top - pane.scrollTop - below;
          // With no height left the card takes the page's width and the pane scrolls.
          stage.style.width = height > 0 ? `${(height * 16) / 9}px` : "";
          frame.style.transform = `scale(${stage.clientWidth / frame.offsetWidth})`;
        };
        new ResizeObserver(fit).observe(pane);
        // A face that loads late changes the story bar's height but not the pane's.
        document.fonts.ready.then(fit);
      }
    </script>
  </div>
)}

<style>
  /* A deck's page stays light behind a light slide when the catalog is dark. */
  .slide-story {
    position: fixed;
    inset: 0;
    overflow: auto;
    background: var(--color-bg);
    color-scheme: light;
    /* A deck's html sets Tailwind's line height of 1.5, which Astrobook's unlayered html rule
       (1.15) beats; brand has no token for it yet. */
    line-height: 1.5;
  }
  .story-embed {
    padding: 1rem;
  }
  .story-stage {
    position: relative;
    max-width: 100%;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    --hw-card-pad: 0;
  }
  .story-stage iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--slide-page-width);
    height: var(--slide-page-height);
    border: 0;
    transform-origin: 0 0;
  }
</style>

---
// A slide fills its window (fixed, vh type, the stage rem from its width), so the dashboard frames
// the story's preview page in brand's card; `?revealed` opens a slide with every build step shown.
interface Props {
  component: string;
  part?: boolean;
}
const { component, part } = Astro.props;
const path = Astro.url.pathname;
const preview = path.includes("/stories/");
const src = path.replace("/dashboard/", "/stories/");
---

{preview ? (
  <div class="slide-story" data-story-of={component} data-hw-scale="stage">
    {!part && <script is:inline>
      {
        const url = new URL(location.href);
        url.searchParams.set("revealed", "");
        history.replaceState(history.state, "", url);
      }
    </script>}
    <slot />
  </div>
) : (
  <div class="story-embed" data-story-of={component}>
    <iframe class="hw-card" src={src} title={`${component} story`} loading="lazy" />
    <a href={src} target="_blank" rel="noreferrer">
      Open full screen
    </a>
  </div>
)}

<style>
  /* A deck's page stays light behind a light slide when the catalogue is dark. */
  .slide-story {
    position: fixed;
    inset: 0;
    overflow: auto;
    background: var(--color-bg);
    color-scheme: light;
    /* A deck's html sets Tailwind's line height of 1.5, which Astrobook's unlayered html rule
       (1.15) beats; brand has no token for it yet. */
    line-height: 1.5;
  }
  .story-embed {
    padding: 1rem;
  }
  .story-embed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    --hw-card-pad: 0;
  }
  .story-embed a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--text-ui);
    color: inherit;
  }
</style>

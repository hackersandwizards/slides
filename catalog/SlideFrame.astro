---
// A slide fills its window (fixed, vh type, the stage rem from its width), so the dashboard frames
// the story's preview page; "back" opens a slide with every progressive step shown.
interface Props {
  component: string;
  part?: boolean;
}
const { component, part } = Astro.props;
const path = Astro.url.pathname;
const preview = path.includes("/catalog/stories/");
const src = path.replace("/catalog/dashboard/", "/catalog/stories/");
---

{
  preview ? (
    <div class="slide-story" data-story-of={component} data-hw-scale="stage">
      {!part && (
        <script is:inline>sessionStorage.setItem("slide-direction", "back");</script>
      )}
      <slot />
    </div>
  ) : (
    <div class="story-embed" data-story-of={component}>
      <iframe src={src} title={`${component} story`} loading="lazy" />
      <a href={src} target="_blank" rel="noreferrer">
        Open full screen
      </a>
    </div>
  )
}

<style>
  /* A deck's page stays light behind a light slide when the catalogue is dark. */
  .slide-story {
    position: fixed;
    inset: 0;
    overflow: auto;
    background: var(--color-bg);
    color-scheme: light;
  }
  .story-embed {
    padding: 1rem;
  }
  .story-embed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .story-embed a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--text-ui);
    color: inherit;
  }
</style>

---
// A slide fills its window (fixed, vh type, the stage rem from its width), so the dashboard frames
// the story's preview page in brand's card; "back" opens a slide with every progressive step shown.
// Exported, so a consumer's catalog frames its deck's stories the same way.
interface Props {
  component: string;
  part?: boolean;
}
const { component, part } = Astro.props;
const path = Astro.url.pathname;
const preview = path.includes("/stories/");
const src = path.replace("/dashboard/", "/stories/");
---

{preview ? (
  <div class="slide-story" data-story-of={component} data-hw-scale="stage">
    {!part && <script is:inline>
      sessionStorage.setItem("slide-direction", "back");
    </script>}
    <slot />
  </div>
) : (
  <div class="story-embed" data-story-of={component}>
    <iframe class="hw-card" src={src} title={`${component} story`} loading="lazy" />
    <a href={src} target="_blank" rel="noreferrer">
      Open full screen
    </a>
  </div>
)}

<style>
  /* A deck's page stays light behind a light slide when the catalogue is dark. */
  .slide-story {
    position: fixed;
    inset: 0;
    overflow: auto;
    background: var(--color-bg);
    color-scheme: light;
    /* What the slide inherits in a deck: Tailwind's line height on <html> and the body's sans face,
       smoothed. Astrobook's unlayered html rule (system-ui, line height 1.15) beats the layered
       Tailwind base, which re-wraps text and re-scales the fit guard's slides. */
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .story-embed {
    padding: 1rem;
  }
  .story-embed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    --hw-card-pad: 0;
  }
  .story-embed a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--text-ui);
    color: inherit;
  }
</style>

---
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
import elements from "../brand-elements.json";

const HOME = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const PRINT = `${HOME}catalog/print/`;
const exceptions = Object.entries(
  elements.exceptions as Record<string, string | { reason: string }>,
).map(([name, e]) => [name, typeof e === "string" ? e : e.reason]);
---

<Home>
  <div class="ds-foundations">
    <p>
      Tokens (<code>styles/tokens.css</code>) feed the parts, the parts make the slide types. Every
      story renders at the stage scale.
    </p>
    <p>
      Brand elements: {elements.uses.length} from brand, {exceptions.length} kept as the slides'
      own.
    </p>
    {/* prettier-ignore */}
    <p>From brand: {elements.uses.map((name, i) => [i ? ", " : "", <code>hw-{name}</code>])}.</p>
    <ul>
      {exceptions.map(([name, reason]) => (
        <li>
          <code>{name}</code>: {reason}
        </li>
      ))}
    </ul>
    <p>
      <a href={`${PRINT}#elements`}>The print page</a> shows each as a tile.
    </p>
  </div>
</Home>

<style>
  .ds-foundations {
    margin-top: 1.5rem;
    font-size: var(--text-ui);
  }
  .ds-foundations p,
  .ds-foundations ul {
    margin: 0 0 0.75rem;
  }
</style>
